# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Generator: groq | gemini. Free tiers: Groq ~200k tokens/day per model, Gemini ~20 requests/day per model.
LLM_PROVIDER=groq
# Model names change on free tiers - check them on Day 1.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SMALL_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b
WHISPER_MODEL=whisper-large-v3

# Tuning
DEFAULT_STRATEGY=tot
TOT_BREADTH=3
TOT_DEPTH=2
SIM_THRESHOLD=0.6
MAX_WORKERS=4
# Seconds between calls per provider, to respect free-tier requests-per-minute
MIN_SECONDS_BETWEEN_CALLS=0

# Judge: must differ from the generator. "auto" = the other provider.
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
